{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|clear", "hooks": [{ "type": "command", "command": "node scripts/agent-guard.mjs session" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node scripts/agent-guard.mjs prompt" }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [{ "type": "command", "command": "node scripts/agent-guard.mjs check" }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node scripts/agent-guard.mjs bash" }] },
      { "matcher": "PowerShell", "hooks": [{ "type": "command", "command": "node scripts/agent-guard.mjs powershell" }] }
    ]
  }
}
